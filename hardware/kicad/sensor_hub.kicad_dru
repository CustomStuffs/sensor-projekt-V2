(version 1)

# Relay contacts switch up to 230 VAC. MAINS nets need reinforced separation
# (8 mm creepage + clearance) from everything else, incl. no-net copper.
# See hardware/docs/pcb_guidelines.md -> Relay Zone Rules. Later rules win.

(rule "MAINS to SELV clearance"
	(condition "A.hasNetclass('MAINS') && !B.hasNetclass('MAINS')")
	(constraint clearance (min 8mm)))

(rule "MAINS to SELV creepage"
	(condition "A.hasNetclass('MAINS') && !B.hasNetclass('MAINS')")
	(constraint creepage (min 8mm)))

(rule "MAINS to SELV hole clearance"
	(condition "A.hasNetclass('MAINS') && !B.hasNetclass('MAINS')")
	(constraint hole_clearance (min 8mm)))

# Functional insulation inside one relay channel (230 V across an open contact)
(rule "MAINS same channel"
	(condition "A.hasNetclass('MAINS') && B.hasNetclass('MAINS')")
	(constraint clearance (min 1.5mm)))

# The two relay channels may sit on different circuits / phases
(rule "MAINS K1 to K2"
	(condition "A.hasNetclass('MAINS') && B.hasNetclass('MAINS') && A.NetName == '/K1_*' && B.NetName == '/K2_*'")
	(constraint clearance (min 4mm)))

# Socket/header GND pins sit between signal tracks; THT pads reach the GND pour on
# both layers, so one thermal spoke per layer is enough there.
(rule "Header GND pins: 1 spoke"
	(condition "A.Type == 'Pad' && A.NetName == '/GND' && (A.memberOfFootprint('U1') || A.memberOfFootprint('J11'))")
	(constraint min_resolved_spokes 1))
